<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- clear ignores the machine-level sources so restore does not depend on this developer's
       NuGet.Config. This project only needs nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
